.{
    .name = .yaml,
    .version = "0.3.0",
    .fingerprint = 0xea31a98467e0804e, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.1",
    .dependencies = .{
        // yaml/yaml-test-suite's data tree at tag data-2022-01-17, pinned
        // by its commit (a tag can move): one directory per test id. The
        // newest data tag; main has changed no test since. Lazy, so a
        // package depending on this one never fetches it.
        .yaml_test_suite = .{
            .url = "https://github.com/yaml/yaml-test-suite/archive/6e6c296ae9c9d2d5c4134b4b64d01b29ac19ff6f.tar.gz",
            .hash = "N-V-__8AANRsAQDW5NhaTJne--X37O2KNP_maPss14w82QAh",
            .lazy = true,
        },
        // libfyaml 0.9.6 (MIT), another reader that passes the whole
        // yaml-test-suite: the differential fuzz target holds yaml.zig's
        // events to its (karte t68). Fetched only with -Ddifferential.
        .libfyaml = .{
            .url = "https://github.com/pantoniou/libfyaml/releases/download/v0.9.6/libfyaml-0.9.6.tar.gz",
            .hash = "N-V-__8AAFR0VgDDy_n_kVH6deo8rjeww_X1D9Wy50H2X8-B",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
        "LICENSE",
    },
}
